# Project Configuration
PROJECT_NAME="Multi-Vendor SaaS E-Commerce"
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=10000

# Security (Change in production!)
SECRET_KEY=generate_a_secure_random_secret_key_for_production_use_only_64chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL on Render / Neon / Supabase)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/multi_vendor_Saas_app

# CORS Settings (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["https://your-service-name.onrender.com","http://localhost:8000"]

# Stripe API Keys (Test or Live)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
STRIPE_CURRENCY="usd"

# Google Gemini AI Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"
